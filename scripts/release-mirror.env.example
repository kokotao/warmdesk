# WarmDesk release mirror settings for local dry-run or an operator-hosted sync.
# GitHub Actions should use repository secrets instead of committing this file
# with real values:
#   WARM_DESK_MIRROR_SSH_KEY
#   WARM_DESK_MIRROR_HOST
#   WARM_DESK_MIRROR_ROOT
#   WARM_DESK_MIRROR_BASE_URL
# Never put private keys, passwords, or access tokens in the repository.
GITHUB_REPOSITORY="kokotao/warmdesk"
NOTE_MIRROR_HOST="release-sync@example.com"
NOTE_MIRROR_ROOT="/opt/1panel/www/sites/lizi/index/warmdesk/releases"
NOTE_MIRROR_BASE_URL="https://note.lizipro.cn/warmdesk/releases"
